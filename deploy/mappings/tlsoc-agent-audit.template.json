{
  "index_patterns": [
    "tlsoc-agent-audit-*"
  ],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "date_detection": false,
      "properties": {
        "ts": {
          "type": "date"
        },
        "case_id": {
          "type": "keyword"
        },
        "app_version": {
          "type": "keyword"
        },
        "build_sha": {
          "type": "keyword"
        },
        "source_id": {
          "type": "keyword"
        },
        "surface": {
          "type": "keyword"
        },
        "actor": {
          "type": "keyword"
        },
        "action_type": {
          "type": "keyword"
        },
        "model": {
          "type": "keyword"
        },
        "prompt_excerpt": {
          "type": "text"
        },
        "query_text": {
          "type": "text",
          "fields": {
            "keyword": {
              "type": "keyword",
              "ignore_above": 2048
            }
          }
        },
        "tool_name": {
          "type": "keyword"
        },
        "tool_input": {
          "type": "object",
          "enabled": false
        },
        "tool_output_summary": {
          "type": "text"
        },
        "result_summary": {
          "type": "text"
        },
        "outcome": {
          "type": "keyword"
        },
        "actor_type": {
          "type": "keyword"
        },
        "action": {
          "type": "keyword"
        },
        "actor_role": {
          "type": "keyword"
        },
        "client": {
          "properties": {
            "ip": {
              "type": "ip"
            },
            "ip_source": {
              "type": "keyword"
            },
            "peer": {
              "type": "keyword",
              "index": false,
              "doc_values": false
            },
            "forwarded_for": {
              "type": "text",
              "index": false
            },
            "user_agent": {
              "type": "text",
              "index": false
            }
          }
        },
        "session_ref": {
          "type": "keyword"
        },
        "target": {
          "properties": {
            "type": {
              "type": "keyword"
            },
            "id": {
              "type": "keyword"
            },
            "label": {
              "type": "text",
              "fields": {
                "keyword": {
                  "type": "keyword",
                  "ignore_above": 256
                }
              }
            },
            "revision": {
              "type": "long"
            }
          }
        },
        "changes": {
          "type": "object",
          "enabled": false
        },
        "request_id": {
          "type": "keyword"
        },
        "run_id": {
          "type": "keyword"
        }
      }
    }
  },
  "priority": 600,
  "_meta": {
    "owner": "tlsoc-agentic-triage",
    "contract": "tlsoc-agent-audit"
  }
}
