{
  "name": "tlsoc-console",
  "private": true,
  "version": "0.1.13",
  "type": "module",
  "description": "Agentic SOC, the standalone operator interface for agentic security operations.",
  "scripts": {
    "predev": "npm run docs:bundle",
    "dev": "vite",
    "build": "npm run docs:bundle && npm run build:app",
    "build:app": "tsc --noEmit && vite build",
    "docs:bundle": "python3 ../scripts/run_docs_bundle.py --output public/docs",
    "docs:check": "python3 ../scripts/run_docs_bundle.py --output public/docs --check-only",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:strict:contract": "node --test scripts/test-strict.test.mjs",
    "test:strict": "npm run test:strict:contract && node scripts/test-strict.mjs",
    "gates": "node scripts/gates.mjs",
    "gates:update-baseline": "node scripts/gate-grep.mjs --update",
    "gen:types": "node scripts/gen-types.mjs",
    "check:types": "node scripts/check-types.mjs",
    "gen:console-map": "vitest run src/soc/__tests__/console-map.contract.test.ts --mode console-map-write",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-hover-card": "^1.1.17",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-radio-group": "^1.4.1",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slider": "^1.4.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toast": "^1.2.17",
    "@radix-ui/react-tooltip": "^1.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.456.0",
    "motion": "12.42.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-grid-layout": "^2.2.3",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.62.0",
    "vite": "5.4.11",
    "vitest": "^1.6.1"
  }
}
