# =============================================================================
# Agentic SOC — environment template (TLSOC_* compatibility variables remain stable).
#
# Copy this file to `.env` and fill it in. NEVER commit the real .env. All secrets
# live here / in the environment only — never in the webui, never in any
# Elasticsearch index.
#
# Two deploy shapes read these same TLSOC_* names (see DEPLOY.md):
#   - PRIMARY / agnostic stack: put `.env` at the repo root, next to
#     deploy/docker-compose.agnostic.yml (Postgres+pgvector + Redis + backend +
#     webui — no Elasticsearch required for the suite's own state).
#   - Legacy ELK merge (optional, Mode B): put `.env` in the TLSOCDockerDeploy
#     directory, next to its docker-compose.yml, so
#     deploy/docker-compose.tlsoc.yml's service block can join that stack.
# Operational TLSOC_* names are mapped into the backend container's UNPREFIXED
# settings (e.g. `TLSOC_ES_API_KEY` -> `ES_API_KEY`) by Compose. The release-
# identity names below are Docker build metadata and retain the TLSOC_* prefix.
# For the primary stack, use `scripts/agentic-soc-compose.sh` after setup. The
# wrapper preserves the digest-pinned host release override written by the update
# supervisor; raw Compose commands are unsupported after a supervised update.
# See docs/ENVIRONMENT.md §2 for the full mapping.
# =============================================================================

# --- Release identity (non-secret) -------------------------------------------
# Source builds are Testing by default. Set `stable` only when building the exact
# accepted main/tag commit; a branch name alone does not make an artifact Stable.
TLSOC_VERSION=0.1.13
TLSOC_RELEASE_CHANNEL=testing
TLSOC_BUILD_SHA=unknown
TLSOC_BUILD_DATE=unknown

# Public repository whose immutable Stable tags and release workflow the private
# update supervisor trusts. Forks may change this before bootstrapping the
# supervisor; the browser cannot override it per request.
AGENTIC_SOC_UPDATE_REPOSITORY=ARYDESTROYER/Agentic-Kibana

# --- Elasticsearch credentials (TWO scoped API keys; NEVER the superuser) ------
# 1) Read-only key, scoped to your log indices. The agent uses ONLY this to read
#    logs. Mint in Kibana: Stack Management > Security > API keys > Create API key,
#    choose "Restrict privileges", and paste this role descriptor:
#      {
#        "tlsoc_agent_readonly": {
#          "indices": [
#            { "names": ["all-logs-*"], "privileges": ["read","view_index_metadata"] }
#          ]
#        }
#      }
TLSOC_ES_API_KEY=

# 2) Management key, scoped to the suite's OWN indices only (read/write/create).
#    The backend uses this to own its cases/audit/usage/config/cursor indices.
#    Role descriptor:
#      {
#        "tlsoc_agent_mgmt": {
#          "cluster": ["manage_ilm", "manage_index_templates", "monitor"],
#          "indices": [
#            { "names": ["tlsoc-agent-*"],
#              "privileges": ["read","write","create_index","view_index_metadata","manage"] }
#          ]
#        }
#      }
#    The cluster privileges are used only by the explicit Storage & retention
#    preview/apply flow. Omit them if native Hot/Warm lifecycle will not be used.
TLSOC_ES_MGMT_API_KEY=

# --- LLM providers (configure at least one) -----------------------------------
# Fresh workspaces use OpenAI GPT-5.6 Luna for every completion role. Embeddings
# remain on the dedicated text-embedding-3-small model. Anthropic and every other
# supported provider remain selectable in Settings; existing assignments are kept.
TLSOC_OPENAI_API_KEY=
TLSOC_ANTHROPIC_API_KEY=

# --- Cloud LLM providers (Round 3; OPTIONAL — all default-off) -----------------
# The gateway remains provider-agnostic: OpenAI is the fresh-install default, and these
# add first-class Azure OpenAI, AWS Bedrock, and Google Vertex. An OpenAI-compatible
# base_url (vLLM/Ollama/OpenRouter/Together/Groq) needs no new key — set the model's
# `base_url` in Settings -> Models and reuse TLSOC_OPENAI_API_KEY. The UI shows every
# key as a boolean `configured ✓`, never the value. Uncomment only what you use.
#   Azure OpenAI:
# TLSOC_AZURE_OPENAI_API_KEY=
# TLSOC_AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# TLSOC_AZURE_OPENAI_API_VERSION=2024-10-21
#   AWS Bedrock (gateway signs requests with stdlib SigV4 — no boto3 dependency):
# TLSOC_AWS_ACCESS_KEY_ID=
# TLSOC_AWS_SECRET_ACCESS_KEY=
# TLSOC_AWS_REGION=us-east-1
#   Google Vertex AI (short-lived OAuth access token as a Bearer):
# TLSOC_VERTEX_PROJECT=
# TLSOC_VERTEX_LOCATION=us-central1
# TLSOC_VERTEX_API_KEY=
#   Local / self-hosted LiteLLM, vLLM, Ollama, or any OpenAI-compatible endpoint
#   (Round 9): reuses the `openai_compatible` provider — set the model's `base_url`
#   in Settings -> Models (or the wizard's "Add local model" dialog), no key
#   required for a no-auth local endpoint. This key is OPTIONAL and has three
#   supply paths: (a) set it here as an env var (NOTE: the agnostic compose does
#   not forward LITELLM_API_KEY to the backend today — add an
#   `- LITELLM_API_KEY=${TLSOC_LITELLM_API_KEY:-}` line to its `environment:`
#   block if you want this path); (b) push it at runtime via the "Add local
#   model" dialog (POST /api/llm/models/custom); or (c) omit it entirely and let
#   the gateway fall back to TLSOC_OPENAI_API_KEY.
# TLSOC_LITELLM_API_KEY=

# --- Enrichment providers (optional; enrichment degrades gracefully without) ---
# The two original providers (kept):
TLSOC_ABUSEIPDB_API_KEY=
TLSOC_VIRUSTOTAL_API_KEY=
#
# Round 3 added 17 providers behind an EnrichmentProvider SPI (IP/domain/hash/url/
# email indicators, type-routed, fail-open + cached). KEYLESS providers (Shodan
# InternetDB, IPinfo Lite, abuse.ch URLhaus/MalwareBazaar/ThreatFox, RDAP/DoH) are
# DEFAULT-ON and need no key. The keyed providers below are all OPTIONAL + default-off
# (most have generous free community tiers — mind their tiny rate limits). Toggle each
# in Settings -> Enrichment; the key only enables it. Uncomment only what you use.
# TLSOC_GREYNOISE_API_KEY=        # GreyNoise Community (IP — 50 lookups/week free)
# TLSOC_SHODAN_API_KEY=           # Shodan host (IP — ~1 req/s)
# TLSOC_CENSYS_API_ID=            # Censys host (IP — id + secret, ~1 req/2.5s)
# TLSOC_CENSYS_API_SECRET=
# TLSOC_BINARYEDGE_API_KEY=       # BinaryEdge host (IP)
# TLSOC_IPINFO_TOKEN=             # IPinfo (IP geo/ASN — optional, raises the free cap)
# TLSOC_OTX_API_KEY=              # AlienVault OTX (IP/domain/hash/url)
# TLSOC_PULSEDIVE_API_KEY=        # Pulsedive (IP/domain/url)
# TLSOC_SPUR_API_KEY=             # Spur (IP — VPN/proxy/anonymization context)
# TLSOC_XFORCE_API_KEY=           # IBM X-Force Exchange (IP/domain/hash — key + password)
# TLSOC_XFORCE_API_PASSWORD=
# TLSOC_URLSCAN_API_KEY=          # URLscan.io (url/domain)
# TLSOC_HIBP_API_KEY=             # Have I Been Pwned (email breach exposure)
# TLSOC_HONEYPOT_ACCESS_KEY=      # Project Honeypot http:BL (IP — also set use_honeypot in Settings)
# TLSOC_ABUSECH_AUTH_KEY=         # abuse.ch optional Auth-Key (lifts the keyless rate caps)
#
# Round 11 added 19 more providers. KEYLESS + default-ON: CIRCL hashlookup
# (known-good hashes), SANS ISC DShield (IP sensor sightings), Onionoo (Tor
# relay/exit). KEYLESS but default-OFF (opt in via Settings -> Enrichment):
# Spamhaus ZEN/DBL + Team Cymru MHR (DNS lookups — need the host's OWN recursive
# resolver, public resolvers are refused), Robtex + crt.sh (slow free tiers).
# The keyed providers below are OPTIONAL + default-off; each Settings card shows
# step-by-step setup. Uncomment only what you use.
# NOTE (agnostic stack): the frozen v1 base compose does not forward these 12
# Round-11 vars — start with the additive overlay instead:
#   ./scripts/agentic-soc-compose.sh -f deploy/docker-compose.enrichment-keys.yml up -d
# The legacy stack (docker-compose.tlsoc.yml) forwards them directly.
# TLSOC_CROWDSEC_API_KEY=         # CrowdSec CTI (IP — crowd behavioural reputation)
# TLSOC_GOOGLE_SAFEBROWSING_API_KEY=  # Google Safe Browsing v4 (url/domain — Chrome's lists)
# TLSOC_IPQUALITYSCORE_API_KEY=   # IPQualityScore (IP/url/email — 0..100 fraud score)
# TLSOC_IPDATA_API_KEY=           # ipdata (IP — known-attacker/Tor/proxy + geo, 1.5k/day free)
# TLSOC_APIVOID_API_KEY=          # APIVoid (IP/domain/url — ~90-engine blacklist ratio)
# TLSOC_MALTIVERSE_API_KEY=       # Maltiverse (IP/domain/sha256 — aggregated classification)
# TLSOC_SECURITYTRAILS_API_KEY=   # SecurityTrails (domain DNS/hosting context — 50/mo free)
# TLSOC_CRIMINALIP_API_KEY=       # Criminal IP (IP — graded inbound/outbound risk)
# TLSOC_NETLAS_API_KEY=           # Netlas (IP/domain — internet-scan host profile)
# TLSOC_HYBRID_ANALYSIS_API_KEY=  # Hybrid Analysis (file hash — sandbox verdicts)
# TLSOC_METADEFENDER_API_KEY=     # OPSWAT MetaDefender (file hash — multi-engine AV ratio)
# TLSOC_EMAILREP_API_KEY=         # EmailRep (email — sender reputation for phishing/BEC)

# --- Embeddings for RAG (optional; falls back to local hashing embeddings) -----
# If blank, the OpenAI key above is used for embeddings.
TLSOC_EMBEDDING_API_KEY=

# --- OWN-state backend (where the suite stores cases/audit/usage/config/cursor) -
# Vendor-agnostic self-hosting (docs/AGNOSTIC_ARCHITECTURE.md). The agent's READ-ONLY
# log surface ALWAYS uses the connector layer (TLSOC_ES_API_KEY) regardless of
# this — this only chooses where the suite's OWN bookkeeping lives:
#   elasticsearch (default) — tlsoc-agent-* indices via TLSOC_ES_MGMT_API_KEY.
#   postgres                — PostgreSQL (+pgvector for RAG); NO Elasticsearch needed.
#   sqlite                  — a local SQLite file (zero extra services; single-node).
# When postgres/sqlite, TLSOC_ES_MGMT_API_KEY is not required.
TLSOC_STATE_BACKEND=elasticsearch
# SQLAlchemy async URL for the SQL backends. Examples:
#   postgres: postgresql+asyncpg://tlsoc:password@tlsoc-postgres:5432/tlsoc
#   sqlite:   sqlite+aiosqlite:////data/tlsoc.db    (blank → ./tlsoc.db)
TLSOC_STATE_DB_URL=

# Server-generated background-job artifacts (for example full Data export ZIPs).
# The legacy ELK merge profile maps this to a dedicated persistent volume. The
# updater-managed standalone Compose v1 remains byte-pinned, so extend it with a
# reviewed override if artifacts must survive container replacement. Keep this
# directory private to the backend; it must never be web-served/shared.
TLSOC_JOBS_ARTIFACT_DIR=/var/lib/agentic-soc/jobs

# --- PostgreSQL (used ONLY by deploy/docker-compose.agnostic.yml) --------------
# The agnostic stack runs Postgres+pgvector for the app's own state and builds
# STATE_DB_URL automatically from these. TLSOC_PG_PASSWORD is REQUIRED there.
TLSOC_PG_USER=tlsoc
TLSOC_PG_PASSWORD=
TLSOC_PG_DB=tlsoc

# --- Log SOURCE cluster (optional; for an Elasticsearch/OpenSearch/Wazuh source)
# A read-only key + URL for the cluster you read logs FROM. You can also enter
# these in the first-run wizard. Per-source field mapping is set in the wizard;
# these just point at the cluster. (TLSOC_ES_API_KEY above is reused as the
# read-only log key.) For a private CA, mount it and set TLSOC_ES_CA_CERT.
TLSOC_ES_URL=
TLSOC_ES_CA_CERT=
TLSOC_ES_VERIFY_CERTS=true

# --- Cache (optional) ----------------------------------------------------------
# Leave default to use the bundled tlsoc-redis service; set empty to force the
# in-memory cache fallback.
TLSOC_REDIS_URL=redis://tlsoc-redis:6379/0

# --- Logging -------------------------------------------------------------------
TLSOC_LOG_LEVEL=INFO

# --- API auth + RBAC + MFA + SSO (default OFF — the no-auth deployment is fully
# supported and unchanged out of the box). See SECURITY.md "Optional API
# authentication" + "RBAC / MFA / SSO", DEMO.md, and DEPLOY.md §9. ---
#
# ╔═══ DEMO / QUICK START ════════════════════════════════════════════════════╗
# ║ Set TLSOC_AUTH_ENABLED=true to enable the LOGIN screen + 6-role RBAC +     ║
# ║ MFA + SSO. When auth is enabled AND the user store is empty, the backend  ║
# ║ AUTO-SEEDS a demo super_admin:   Admin / Admin@123                         ║
# ║ (change it immediately for any real use). The committed default below     ║
# ║ stays FALSE so the out-of-the-box / test experience is unchanged.         ║
# ║ scripts/run-demo.sh enables auth + a dev JWT secret for you.              ║
# ╚════════════════════════════════════════════════════════════════════════════╝
TLSOC_AUTH_ENABLED=false
# HS256 session-signing key. Set a STABLE 32+ byte secret, else it is ephemeral
# and ALL sessions die on every backend restart. e.g. `openssl rand -hex 32`.
TLSOC_AUTH_JWT_SECRET=
# Env single-admin fallback (separate from the auto-seeded demo super_admin
# above): username + plaintext password (hashed in memory at startup, never
# stored). Granted super_admin. Optional once you create users in the UI.
TLSOC_AUTH_ADMIN_USERNAME=admin
TLSOC_AUTH_ADMIN_PASSWORD=
# Optional multi-user map (username -> PBKDF2 hash) supplied at boot:
# TLSOC_AUTH_USERS={"alice":"pbkdf2_sha256$...","bob":"pbkdf2_sha256$..."}
TLSOC_AUTH_USERS={}
TLSOC_AUTH_TOKEN_HOURS=12
TLSOC_AUTH_COOKIE_SECURE=false        # set true behind TLS (HTTPS-only cookie)
#
# RBAC: 6 roles — super_admin / soc_manager / analyst_tier2 / analyst_tier1 /
# responder / auditor — enforced server-side (require_permission) + in the UI
# (<Can> guards). When auth is OFF every user is treated as super_admin.
#
# MFA (per-user opt-in RFC-6238 TOTP, inline-SVG QR, single-use recovery codes).
# The per-user TOTP secret is OBFUSCATED at rest with this key; leave BLANK to
# derive it from TLSOC_AUTH_JWT_SECRET. NOTE: stdlib obfuscation, NOT a KMS
# (hardening TODO — see SECURITY.md / auth/mfa.py).
TLSOC_MFA_OBFUSCATION_KEY=
#
# SSO (OIDC; Google / Microsoft / generic). Providers are configured in Settings
# (issuer/client-id/redirect); their CLIENT SECRETS stay in the SECRET tier. Set
# as a JSON object keyed by provider id, e.g.
# TLSOC_SSO_CLIENT_SECRETS={"google":"GOCSPX-...","corp":"..."} — or push at runtime
# via POST /api/auth/sso/providers/{id}/secret (super_admin). The redirect/callback
# URI to register with the IdP is  <base-url>/api/auth/sso/callback . Group->role
# provisioning maps IdP groups onto the 6 roles. (id_token signature-verify is a
# documented hardening TODO — server-side code-exchange + userinfo today.)
TLSOC_SSO_CLIENT_SECRETS={}
#
# Opt-in hardening middleware (independent of auth):
TLSOC_SECURITY_HEADERS_ENABLED=true
TLSOC_RATE_LIMIT_ENABLED=false
TLSOC_CSRF_ENABLED=false              # requires API clients to send X-CSRF-Token

# --- Notifications (default OFF; channels configured in Settings). The channel
# SECRET (SMTP password / Slack/Teams/webhook URL / PagerDuty/Telegram token)
# lives in the SECRET tier — set via the UI / POST /api/notifications/channels/
# {id}/secret, or seed at boot here as a JSON map of channel id -> {field: value}.
# Email is stdlib SMTP with 13 provider presets. e.g.
# TLSOC_NOTIFICATION_SECRETS={"email-ops":{"secret":"<smtp-password>"},"slack-soc":{"secret":"https://hooks.slack.com/services/..."}}
# See DEPLOY.md §10 (Notifications) for SMTP/Slack setup.
TLSOC_NOTIFICATION_SECRETS={}

# --- Fields intentionally NOT exposed here -------------------------------------
# A handful of `Secrets` fields (backend/app/config.py) are deliberately left off
# this template — they're either internal wiring, low-risk operational tuning, or
# a one-time bootstrap fallback, and don't need a `.env` override for normal use:
#   es_request_timeout                        (ES client timeout, seconds)
#   backend_host / backend_port               (FastAPI bind address; container-internal)
#   es_store_enabled                          (bootstraps tlsoc-agent-* indices/templates)
#   rate_limit_capacity / rate_limit_refill_per_second  (token-bucket tuning for
#                                                the opt-in rate-limit middleware)
#   auth_seed_admin / auth_seed_admin_username / auth_seed_admin_password
#     (the Admin/Admin@123 demo super_admin auto-seeded when auth is enabled and
#     the user store is empty — change the password in the UI, don't override it
#     here)
# Set them directly in the backend container's environment (bypassing the
# TLSOC_* -> unprefixed mapping) if you need to change one of these.
