# ---- Secrets (NEVER commit) ----
.env
*.env
!*.env.example
*.key
*.pem
certs/

# ---- Local AD-attack replay data + tooling (not shipped) ----
# Anchored to the repo root: an unanchored `scripts/` / `rules/` would also hide
# new files in tracked dirs like webui/scripts/ and webui/src/soc/components/rules/.
/rules/
/scripts/replay/
/scripts/simulate_attack.py
/scripts/sync_runbooks.py
/EVTX-ATTACK-SAMPLES/
/ingestion-scripts-/
/Security-Datasets/
/cef_batch.txt
backend/.agentic/
backend/app/runbooks/.synced-manifest.json

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env.local
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
dist/
build/
# MkDocs output (deployed as a Pages artifact, never committed).
site/
*.log

# ---- Node / Kibana plugin build scratch ----
node_modules/
plugin/.cache/
plugin/target/
plugin/build/node_modules/
*.tsbuildinfo

# The built plugin ZIP is a required deliverable — keep it tracked even though the
# generic `dist/` rule above would otherwise ignore it.
!plugin/dist/
!plugin/dist/*.zip

# ---- Local runtime data ----
data/
chroma/
*.sqlite3

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Round-5 temp / caches (do not commit) ----
WORK_TRACKER.md
.vite/
webui/.vite/
**/vitest/results.json
