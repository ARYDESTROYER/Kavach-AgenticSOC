# ---- Secrets (NEVER commit) ----
.env
*.env
!*.env.example
*.key
*.pem
certs/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# Downloaded or locally built wheels never belong in the source tree. CI builds
# its wheel into dist/; keep tool downloads in a session scratchpad instead.
*.whl
# Auto-bootstrapped pinned MkDocs toolchain for one-command Console builds.
/.docs-venv/
/.docs-venv.lock
.env.local
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
dist/
build/
# MkDocs output (deployed as a Pages artifact, never committed).
site/
# Version-matched Help Center copied into Vite's public tree at build time.
/webui/public/docs/
/.agentic-soc-runtime/
*.log

# ---- Node / Kibana plugin build scratch ----
node_modules/
plugin/.cache/
plugin/target/
plugin/build/node_modules/
*.tsbuildinfo

# The built plugin ZIP is a required deliverable — keep it tracked even though the
# generic `dist/` rule above would otherwise ignore it.
!plugin/dist/
!plugin/dist/*.zip

# ---- Local runtime data ----
data/
chroma/
*.sqlite3

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Round-5 temp / caches (do not commit) ----
WORK_TRACKER.md
# Rendered contact sheets and other local review artifacts.
/tmp/
# Per-session agent scratchpad. It may exist while a long task is active, but must
# be deleted before handoff and must never enter source control.
/memory.md
.vite/
webui/.vite/
**/vitest/results.json
